# Strava API credentials for the Hobbies section (src/lib/strava.ts).
# The site degrades gracefully if these are unset — only the static
# description + profile link render, no live stats.
#
# Setup (one-time, manual):
#   1. Create an app at https://www.strava.com/settings/api
#      -> gives you STRAVA_CLIENT_ID and STRAVA_CLIENT_SECRET
#   2. Authorize it once in a browser and exchange the code for a
#      refresh token -> STRAVA_REFRESH_TOKEN
#   3. Copy this file to .env.local and fill in the values below.
#   4. In production, set the same 3 vars in Vercel Project Settings
#      -> Environment Variables, then redeploy.

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
